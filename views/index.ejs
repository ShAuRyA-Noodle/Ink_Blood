<%- include("partials/header") %>

<% if (posts.length === 0) { %>
  <p class="empty">No posts yet. Be the first survivor.</p>
<% } %>

<% posts.forEach(post => { %>
  <div class="post-card">
    <h2><%= post.title %></h2>
    <p><%= post.content.substring(0, 120) %>...</p>

    <a href="/posts/<%= post.id %>" class="link">READ ARTICLE</a>
  </div>
<% }) %>

<%- include("partials/footer") %>
